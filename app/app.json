{
  "expo": {
    "name": "شبكة علاقات الشركة",
    "slug": "relationship-network",
    "scheme": "relnet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "يحتاج التطبيق إذن الكاميرا لتصوير بطاقات العمل."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج التطبيق إذن الصور لاختيار صورة بطاقة العمل."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.relnet.app"
    },
    "android": {
      "package": "com.relnet.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
